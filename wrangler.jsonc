{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eki-joko",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "eki-joko.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["11 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eki-joko",
      "database_id": "b4a73309-0a19-4d30-a8f7-d582417aec81",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
